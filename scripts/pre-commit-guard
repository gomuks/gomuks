#!/usr/bin/env bash
# =============================================================================
# pre-commit-guard — project pre-commit enforcement hook
# =============================================================================
# DO NOT EDIT THIS FILE DIRECTLY.
# It is managed by the opencode skill: pre-commit-guard
# Location: ~/.config/opencode/profiles/default/skills/pre-commit-guard/scripts/pre-commit-guard
#
# Identity stamp (used by the skill to detect staleness):
# pre-commit-guard <2026-04-14>
# If this date is more than 3 days old, the skill will overwrite it on next commit.
#
# Usage:
#   ./pre-commit-guard                    # normal pre-commit (staged files)
#   ./pre-commit-guard --replay <commit>  # apply rules to a previous commit
#
# =============================================================================

set -euo pipefail

# ---- Identity ----------------------------------------------------------------
GUARD_VERSION="2026-04-02"          # ← updated by skill on re-install
GUARD_MAX_AGE_DAYS=3
GUARD_SKILL_SCRIPT="$HOME/.config/opencode/profiles/default/skills/pre-commit-guard/scripts/pre-commit-guard"

# ---- Colours -----------------------------------------------------------------
if [ -t 2 ]; then
  RED='\033[0;31m'; YELLOW='\033[0;33m'; GREEN='\033[0;32m'
  BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'
else
  RED=''; YELLOW=''; GREEN=''; BLUE=''; CYAN=''; NC=''
fi

# ---- Helpers -----------------------------------------------------------------
log()   { echo -e "${BLUE}[pre-commit-guard]${NC} $*"; }
log_r() { echo -e "${CYAN}[pre-commit-guard --replay]${NC} $*"; }
pass()  { echo -e "${GREEN}  ✓${NC} $*"; }
fail()  { echo -e "${RED}  ✗${NC} $*" >&2; }
warn()  { echo -e "${YELLOW}  ⚠${NC} $*" >&2; }

# ---- Inline arg parse (no function nesting) ----------------------------------
MODE="commit"
REPLAY_COMMIT=""
REPLAY_FAILED=0
REPLAY_WARNED=0

for arg in "$@"; do
  case "$arg" in
    --replay)
      MODE="replay"
      shift
      if [ $# -gt 0 ]; then
        REPLAY_COMMIT="$1"
        shift
      else
        echo "pre-commit-guard --replay: missing <commit>" >&2
        exit 2
      fi
      ;;
    --help|-h)
      echo "Usage: pre-commit-guard [--replay <commit>]"
      echo "  --replay <commit>  Apply all rules to a previous commit (dry-run)"
      exit 0
      ;;
    *)
      ;;
  esac
done

# ---- Self-update if stale (commit mode only) ---------------------------------
is_stale() {
  local ts_today ts_file diff
  ts_today=$(date -d "$GUARD_VERSION" +%s 2>/dev/null \
              || date -j -f "%Y-%m-%d" "$GUARD_VERSION" +%s 2>/dev/null \
              || echo 0)
  ts_file=$(stat -c '%Y' "$0" 2>/dev/null \
            || stat -f '%m' "$0" 2>/dev/null \
            || echo 0)
  diff=$(( (ts_today - ts_file) / 86400 ))
  [ "$diff" -gt "$GUARD_MAX_AGE_DAYS" ]
}

reinstall() {
  log "Hook is stale (${GUARD_MAX_AGE_DAYS}+ days old). Re-installing from skill..."
  if [ -f "$GUARD_SKILL_SCRIPT" ]; then
    cp "$GUARD_SKILL_SCRIPT" "$0"
    chmod +x "$0"
    log "Hook updated to $(date +%Y-%m-%d)."
    exec "$0" "$@"   # re-run with fresh copy
  else
    warn "Skill script not found at: $GUARD_SKILL_SCRIPT"
    warn "Cannot auto-update. Commit proceeds without guard."
  fi
}

# =============================================================================
# REPLAY MODE
# Apply current rules to a previous commit without modifying anything.
# =============================================================================

replay_main() {
  local commit="$REPLAY_COMMIT"
  local parent
  local changed_files
  local rule
  local result

  # Resolve parent (skip for root commits)
  if parent=$(git rev-parse "$commit"^ 2>/dev/null); then
    : # good
  else
    log_r "Commit '$commit' is a root commit (no parent) — nothing to diff against."
    log_r "Root commits cannot be replayed."
    exit 0
  fi

  # Confirm commit exists
  git rev-parse --verify --quiet "$commit" >/dev/null 2>&1 \
    || { echo "pre-commit-guard --replay: '$commit' is not a valid commit." >&2; exit 2; }

  log_r "Replaying rules against commit: $commit  (parent: ${parent:0:8})"
  log_r "────────────────────────────────────────────────────────────"

  # Collect changed files in this commit (A=added, M=modified, D=deleted)
  changed_files=$(git diff --name-status "$parent" "$commit" 2>/dev/null \
                  | grep -E '^[AMD]\t' | cut -f2 || true)

  local all_passed=true

  for rule in rule_replay_env_files rule_replay_binary rule_replay_bd_epic; do
    result=$($rule "$commit" "$changed_files") || true
    if [ -n "$result" ]; then
      echo "$result"
      if echo "$result" | grep -q "FAIL\|WARN"; then
        all_passed=false
      fi
    fi
  done

  log_r "────────────────────────────────────────────────────────────"
  if [ "$all_passed" = true ]; then
    log_r "Result: all rules passed for $commit"
    exit 0
  else
    log_r "Result: one or more rules failed/warned for $commit"
    exit 1
  fi
}

# ---- R-02 (replay): .env files in the commit ---------------------------------
# Zero-tolerance: any .env file added or modified in the commit is a fail.
# Never log any variable name or value.
rule_replay_env_files() {
  local commit="$1"; shift
  local changed_files="$1"

  local env_files
  env_files=$(echo "$changed_files" | grep -E '\.env(\.|^$)' || true)

  if [ -z "$env_files" ]; then
    pass "R-02 no-env-files: no .env files in $commit"
    return 0
  fi

  echo "FAIL  R-02 no-env-files: .env file(s) present in $commit"
  echo "      Files: $(echo "$env_files" | tr '\n' ' ')"
  echo "      (Variable names and values are not shown.)"
  REPLAY_FAILED=1
  return 1
}

# ---- R-03 (replay): binary files in the commit -------------------------------
rule_replay_binary() {
  local commit="$1"; shift
  local changed_files="$1"

  local binary_files
  binary_files=$(echo "$changed_files" | while IFS= read -r f; do
    if ! git show --no-patch --format='' "$commit" -- "$f" 2>/dev/null; then
      continue
    fi
    mime=$(git cat-file -t "$commit":"$f" 2>/dev/null \
           && file -b --mime-type - < <(git cat-file blob "$commit":"$f" 2>/dev/null) \
           || echo "unknown")
    [ "$mime" = "application/octet-stream" ] && echo "$f"
  done 2>/dev/null || true)

  if [ -z "$binary_files" ]; then
    pass "R-03 no-binary-secrets: no binary files in $commit"
    return 0
  fi

  echo "WARN  R-03 no-binary-secrets: binary file(s) in $commit (cannot scan contents)"
  echo "      Files: $(echo "$binary_files" | tr '\n' ' ')"
  REPLAY_WARNED=$((REPLAY_WARNED + 1))
  return 0
}

# ---- R-04 (replay): bd epic linkage -------------------------------------------
rule_replay_bd_epic() {
  local commit="$1"; shift
  local changed_files="$1"

  # Skip if not a bd project
  if ! git show --no-patch --format='' "$commit" -- ".beads/epics/" >/dev/null 2>&1; then
    return 0
  fi

  local bead_files
  bead_files=$(echo "$changed_files" | grep -E '\.beads?/.*\.ya?ml$' | grep -v '/epics/' || true)

  if [ -z "$bead_files" ]; then
    pass "R-04 bd-epic-linked: no task beads in $commit"
    return 0
  fi

  local unlinked=0
  for bead in $bead_files; do
    if ! git cat-file -t "$commit":"$bead" >/dev/null 2>&1; then
      continue
    fi
    local content
    content=$(git cat-file blob "$commit":"$bead" 2>/dev/null || true)
    if ! echo "$content" | grep -qE '^[[:space:]]*- epic:'; then
      unlinked=$((unlinked + 1))
    fi
  done

  if [ "$unlinked" -gt 0 ]; then
    echo "WARN  R-04 bd-epic-linked: $unlinked bead(s) in $commit not linked to an epic"
    REPLAY_WARNED=$((REPLAY_WARNED + 1))
  else
    pass "R-04 bd-epic-linked: all beads in $commit linked to an epic"
  fi
  return 0
}

# =============================================================================
# COMMIT MODE  (normal pre-commit — staged files)
# =============================================================================

commit_main() {
  log "pre-commit-guard $GUARD_VERSION — running (max age: ${GUARD_MAX_AGE_DAYS}d)"
  log "Running pre-commit checks..."

  # Chain to bd hooks run pre-commit FIRST
  # .git/hooks/pre-commit IS this script (opencode guard).
  # bd shim lives at ~/.local/state/bd/hooks/pre-commit (used by 'bd hooks install').
  # We call 'bd hooks run pre-commit' directly so both guards run.
  log "pre-commit-guard: delegating to bd hooks run pre-commit..."
  if ! bd hooks run pre-commit "$@"; then
    fail "Commit blocked by bd hooks run pre-commit."
    exit 1
  fi

  # R-01 must pass; fail fast
  if ! rule_hooks_executable; then
    fail "Commit blocked by R-01 (hooks-executable)."
    exit 1
  fi

  # R-05 — fast fail: normal commits are gated, must use mise task
  if ! rule_git_commit_gated; then
    fail "Commit blocked by R-05 (git-commit-gated)."
    exit 1
  fi

  # R-02 — hard fail: any staged .env file
  if ! rule_no_env_files; then
    fail "Commit blocked by R-02 (no-env-files)."
    exit 1
  fi

  # R-03 — warning only
  rule_no_binary_secrets || true

  # R-04 — warning only
  rule_bd_epic_linked || true

  # R-08 — hard fail: skills directory structural + wiring violations
  if ! rule_skills_structure; then
    fail "Commit blocked by R-08 (skills-structure)."
    exit 1
  fi

  log "All mandatory checks passed."
  exit 0
}

# ---- R-01: hooks-executable --------------------------------------------------
rule_hooks_executable() {
  local hook_path
  hook_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  if [ ! -x "$hook_path" ]; then
    chmod +x "$hook_path" 2>/dev/null || true
    if [ ! -x "$hook_path" ]; then
      fail "R-01 hooks-executable: $hook_path is not executable"
      return 1
    fi
  fi
  pass "R-01 hooks-executable"
  return 0
}

# ---- R-05: git-commit-gated --------------------------------------------------
rule_git_commit_gated() {
  if mise run --quiet git-commit >/dev/null 2>&1; then
    pass "R-05 git-commit-gated"
    return 0
  fi

  fail "R-05 git-commit-gated: normal commit is gated."
  fail "  → Use: mise run git-commit"
  return 1
}

# ---- R-02: no-env-files ------------------------------------------------------
rule_no_env_files() {
  local env_files
  env_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.env(\.|^$)' || true)
  if [ -z "$env_files" ]; then
    pass "R-02 no-env-files: no .env files staged"
    return 0
  fi

  fail "R-02 no-env-files: .env file(s) are staged and will not be committed."
  fail "  → Unstage:  git reset HEAD -- <file>"
  fail "  → Then remove the file from the commit."
  return 1
}

# ---- R-03: no-binary-secrets -------------------------------------------------
rule_no_binary_secrets() {
  local binary_files
  binary_files=$(git diff --cached --name-only --diff-filter=ACM | while IFS= read -r f; do
    if [ -f "$f" ]; then
      mime=$(file -b --mime-type "$f" 2>/dev/null || echo "application/octet-stream")
      [[ "$mime" == application/octet-stream ]] && echo "$f"
    fi
  done || true)

  if [ -n "$binary_files" ]; then
    warn "R-03 no-binary-secrets: binary files staged — cannot scan for secrets:"
    echo "$binary_files" | while IFS= read -r f; do
      warn "  $f"
    done
  else
    pass "R-03 no-binary-secrets: no binary files staged"
  fi
  return 0
}

# ---- R-04: bd-epic-linked (warn) --------------------------------------------
rule_bd_epic_linked() {
  local epics_dir=".beads/epics"

  if [ ! -d "$epics_dir" ]; then
    return 0
  fi

  local new_beads
  new_beads=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.beads?/.*\.ya?ml$' | grep -v '/epics/' || true)

  if [ -z "$new_beads" ]; then
    pass "R-04 bd-epic-linked: no task beads staged"
    return 0
  fi

  local unlinked=0
  for bead in $new_beads; do
    if ! git diff --cached "$bead" | grep -qE '^[[:space:]]+- epic:'; then
      warn "R-04 bd-epic-linked: $bead has no epic label"
      unlinked=$((unlinked + 1))
    fi
  done

  if [ "$unlinked" -gt 0 ]; then
    warn "R-04: $unlinked bead(s) not linked to an epic (consider adding an epic: label)"
  else
    pass "R-04 bd-epic-linked: all beads linked to an epic"
  fi
  return 0
}

# ---- R-08: skills-structure ---------------------------------------------------
# Run validate_skills.py against all skills roots. Any structural or wiring
# violation (exit != 0) blocks the commit. Only checks skills that are actually
# affected by the staged changes (staged skills roots + repo skills roots).
rule_skills_structure() {
  local validator
  local repo_root
  local skills_root
  local exit_code=0
  local output
  local failed_roots=""

  repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

  # Locate validate_skills.py — prefer the one in the global skills library
  # (vendor-omo/global_profiles/opencode/profiles/default/skills/).
  # Falls back to ~/.claude/skills/ if the repo copy is not available.
  local candidates=(
    "$repo_root/global_profiles/opencode/profiles/default/skills/oqo-skill-writer/scripts/validate_skills.py"
    "$HOME/.claude/skills/oqo-skill-writer/scripts/validate_skills.py"
    "$HOME/.agents/skills/oqo-skill-writer/scripts/validate_skills.py"
  )

  for cand in "${candidates[@]}"; do
    if [ -f "$cand" ]; then
      validator="$cand"
      break
    fi
  done

  if [ -z "$validator" ]; then
    warn "R-08 skills-structure: validate_skills.py not found — skipping"
    warn "  Searched: ${candidates[*]}"
    return 0
  fi

  # Collect roots to check. Always check the repo's skills tree if it exists.
  # Staged skills roots are inferred from staged paths.
  local roots_to_check=()
  local staged_files
  staged_files=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

  # If any staged file is inside a skills directory, add that skills root.
  while IFS= read -r f; do
    case "$f" in
      global_profiles/opencode/profiles/default/skills/*)
        roots_to_check+=("$repo_root/global_profiles/opencode/profiles/default/skills")
        ;;
      .claude/skills/*|.opencode/skills/*|.codex/skills/*|.agents/skills/*)
        # Determine the parent skills root for the matched pattern
        local matched_root
        matched_root=$(echo "$f" | sed -E 's|^(\.claude/|\.opencode/|\.codex/|\.agents/)|\1|; s|/.*||' )
        case "$matched_root" in
          .claude)  roots_to_check+=("$HOME/.claude/skills") ;;
          .opencode) roots_to_check+=("$HOME/.opencode/skills") ;;
          .codex)   roots_to_check+=("$HOME/.codex/skills") ;;
          .agents)  roots_to_check+=("$HOME/.agents/skills") ;;
        esac
        ;;
    esac
  done <<< "$staged_files"

  # Always check the repo's global skills root
  if [ -d "$repo_root/global_profiles/opencode/profiles/default/skills" ]; then
    roots_to_check+=("$repo_root/global_profiles/opencode/profiles/default/skills")
  fi

  # Deduplicate roots_to_check
  local unique_roots=()
  local seen_root
  while IFS= read -r r; do
    [ -z "$r" ] && continue
    local already_seen=false
    for seen_root in "${unique_roots[@]:-}"; do
      if [ "$r" = "$seen_root" ]; then
        already_seen=true
        break
      fi
    done
    if [ "$already_seen" = false ]; then
      unique_roots+=("$r")
    fi
  done <<< "$(printf '%s\n' "${roots_to_check[@]}" | sort -u)"

  if [ ${#unique_roots[@]} -eq 0 ]; then
    pass "R-08 skills-structure: no skills roots found — skipping"
    return 0
  fi

  # Run validate_skills.py against each root. Accumulate failures.
  for skills_root in "${unique_roots[@]}"; do
    if ! [ -d "$skills_root" ] && ! [ -L "$skills_root" ]; then
      continue
    fi

    output=$(python3 "$validator" --root "$skills_root" 2>&1)
    exit_code=$?

    if [ $exit_code -ne 0 ]; then
      fail "R-08 skills-structure: VIOLATIONS in $skills_root"
      # Print only the violation lines (not the full banner)
      echo "$output" | grep -E '^\s+\[(STRUCT|WIRING|NESTED|ORPHANED|ILLEGAL|BROKEN|EMPTY)\]' | sed 's/^/      /' >&2
      failed_roots="$failed_roots  $skills_root"$'\n'
    fi
  done

  if [ -n "$failed_roots" ]; then
    fail ""
    fail "  Fix the structural / wiring violations above before committing."
    fail "  Run the validator manually for full output:"
    fail "    python3 $validator --root <skills-root>"
    return 1
  fi

  pass "R-08 skills-structure: all skills roots passed"
  return 0
}

# =============================================================================
# Entry point
# =============================================================================

if [ "$MODE" = "replay" ]; then
  replay_main
else
  if is_stale; then
    reinstall "$@"
  fi
  commit_main
fi
